{
  "name": "aidescribe",
  "version": "0.0.5",
  "description": "Generate jj change descriptions with AI",
  "keywords": [
    "ai",
    "cli",
    "commit",
    "jj",
    "jujutsu",
    "vcs"
  ],
  "homepage": "https://github.com/pguilbert/aidescribe#readme",
  "bugs": {
    "url": "https://github.com/pguilbert/aidescribe/issues"
  },
  "license": "MIT",
  "author": "Paul Guilbert",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pguilbert/aidescribe.git"
  },
  "bin": {
    "aidescribe": "dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "pkgroll --minify",
    "ci": "pnpm lint && pnpm fmt:check && pnpm typecheck && pnpm test && pnpm build",
    "changeset": "changeset",
    "typecheck": "tsc",
    "dev": "tsx src/cli.ts",
    "prepack": "pnpm run build",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "release": "pnpm run ci && pnpm exec changeset publish",
    "test": "vitest run",
    "test:watch": "vitest",
    "knip": "knip",
    "version-packages": "changeset version"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.5",
    "@ai-sdk/mistral": "^4.0.3",
    "@ai-sdk/openai": "^4.0.5",
    "@clack/prompts": "^1.6.0",
    "@openrouter/ai-sdk-provider": "^2.10.0",
    "ai": "^7.0.11",
    "cleye": "^2.6.0",
    "tinyexec": "^1.2.4",
    "update-notifier": "^7.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@types/node": "^26.1.0",
    "@types/update-notifier": "^6.0.8",
    "knip": "^6.23.0",
    "kolorist": "^1.8.0",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "pkgroll": "^2.27.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
