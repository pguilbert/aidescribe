{
  "name": "aidescribe",
  "version": "0.0.7",
  "description": "Generate jj change descriptions with AI",
  "keywords": [
    "ai",
    "cli",
    "commit",
    "jj",
    "jujutsu",
    "vcs"
  ],
  "homepage": "https://github.com/pguilbert/aidescribe#readme",
  "bugs": {
    "url": "https://github.com/pguilbert/aidescribe/issues"
  },
  "license": "MIT",
  "author": "Paul Guilbert",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pguilbert/aidescribe.git"
  },
  "bin": {
    "aidescribe": "dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "pkgroll --minify",
    "ci": "pnpm lint && pnpm fmt:check && pnpm typecheck && pnpm test && pnpm build",
    "changeset": "changeset",
    "typecheck": "tsc",
    "dev": "tsx src/cli.ts",
    "prepack": "pnpm run build",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "release": "pnpm run ci && pnpm exec changeset publish",
    "test": "vitest run",
    "test:watch": "vitest",
    "knip": "knip",
    "version-packages": "changeset version"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.104",
    "@ai-sdk/mistral": "^4.0.86",
    "@ai-sdk/openai": "^4.0.117",
    "@clack/prompts": "^1.9.0",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "ai": "^7.0.172",
    "cleye": "^2.7.0",
    "tinyexec": "^1.3.1",
    "update-notifier": "^7.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.6",
    "@types/update-notifier": "^6.0.9",
    "knip": "^6.45.1",
    "kolorist": "^1.8.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "pkgroll": "^2.29.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
