{
  "name": "aidescribe",
  "version": "0.0.5",
  "description": "Generate jj change descriptions with AI",
  "keywords": [
    "ai",
    "cli",
    "commit",
    "jj",
    "jujutsu",
    "vcs"
  ],
  "homepage": "https://github.com/pguilbert/aidescribe#readme",
  "bugs": {
    "url": "https://github.com/pguilbert/aidescribe/issues"
  },
  "license": "MIT",
  "author": "Paul Guilbert",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pguilbert/aidescribe.git"
  },
  "bin": {
    "aidescribe": "dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "pkgroll --minify",
    "ci": "pnpm lint && pnpm fmt:check && pnpm typecheck && pnpm test && pnpm build",
    "changeset": "changeset",
    "typecheck": "tsc",
    "dev": "tsx src/cli.ts",
    "prepack": "pnpm run build",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "release": "pnpm run ci && pnpm exec changeset publish",
    "test": "vitest run",
    "test:watch": "vitest",
    "knip": "knip",
    "version-packages": "changeset version"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.71",
    "@ai-sdk/mistral": "^3.0.30",
    "@ai-sdk/openai": "^3.0.53",
    "@clack/prompts": "^1.2.0",
    "ai": "^6.0.168",
    "cleye": "^2.6.0",
    "tinyexec": "^1.1.1",
    "update-notifier": "^7.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.31.0",
    "@types/node": "^25.6.0",
    "@types/update-notifier": "^6.0.8",
    "knip": "^6.6.1",
    "kolorist": "^1.8.0",
    "oxfmt": "^0.35.0",
    "oxlint": "^1.61.0",
    "pkgroll": "^2.27.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
